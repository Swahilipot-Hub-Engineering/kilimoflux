{
  "name": "kilimoflux",
  "version": "0.1.0",
  "description": "Open-source smart agriculture platform integrating LoRaWAN IoT telemetry, satellite remote sensing, AI precision irrigation, and crop pest diagnosis",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "simulate": "tsx src/simulator/runner.ts"
  },
  "keywords": [
    "smart-agriculture",
    "lorawan",
    "iot",
    "satellite",
    "sentinel-2",
    "ndvi",
    "precision-irrigation",
    "ai",
    "pest-diagnosis",
    "kenya",
    "swahilipot"
  ],
  "author": "Swahilipot Hub Engineering",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.5",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
