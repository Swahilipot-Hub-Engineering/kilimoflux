# KilimoFlux Environment Variables

# Node Environment
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# LoRaWAN Configuration (Kenya CAK standard operates under EU868)
LORAWAN_REGION=EU868
LORAWAN_APP_EUI=70B3D57ED0000000
LORAWAN_DOWNLINK_FPORT=10

# ChirpStack / TTN Integration
CHIRPSTACK_API_URL=http://localhost:8080/api
CHIRPSTACK_API_KEY=your_chirpstack_api_token_here

# Satellite Remote Sensing (Copernicus Open Access Hub / Sentinel Hub)
COPERNICUS_CLIENT_ID=your_copernicus_client_id
COPERNICUS_CLIENT_SECRET=your_copernicus_client_secret

# Microclimate & Weather Forecast Provider
WEATHER_API_KEY=your_weather_api_key_here
